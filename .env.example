DB_ENGINE=mysql
DB_NAME=smart_academy_db
DB_USER=smart_academy_user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Africa/Casablanca
PROJECT_MAX_UPLOAD_SIZE_MB=10
RECRUITMENT_MAX_UPLOAD_SIZE_MB=5
RECRUITMENT_PHOTO_MAX_UPLOAD_SIZE_MB=3
RECRUITMENT_RETENTION_DAYS=730
PUBLIC_SUBMISSION_THROTTLE_RATE=5/hour
ANON_THROTTLE_RATE=200/hour
CV_PREVIEW_THROTTLE_RATE=20/hour
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200
DJANGO_SECURE_SSL_REDIRECT=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_RAISE_DELIVERY_ERRORS=False
DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:4200
AI_ASSISTANT_PROVIDER=apps.assistant.services.OllamaAssistantProvider
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_HISTORY=10
OLLAMA_NUM_PREDICT=300
