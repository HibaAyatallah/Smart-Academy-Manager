DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-of-at-least-32-characters
DJANGO_TIME_ZONE=Africa/Casablanca
PROJECT_MAX_UPLOAD_SIZE_MB=10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8001,http://127.0.0.1:8001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8001,http://127.0.0.1:8001
DJANGO_SECURE_SSL_REDIRECT=True

# Local PostgreSQL configuration. DATABASE_URL remains supported and takes
# precedence when it is set; leave it unset to use the DB_* variables below.
DB_ENGINE=postgresql
DB_NAME=smart_academy_db
DB_USER=smart_academy_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://smart_academy_user:password@localhost:5432/smart_academy_db

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
RECRUITMENT_RETENTION_DAYS=730
RECRUITMENT_MAX_UPLOAD_SIZE_MB=5
RECRUITMENT_PHOTO_MAX_UPLOAD_SIZE_MB=3
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_RAISE_DELIVERY_ERRORS=True
EMAIL_LOG_LEVEL=INFO
DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://127.0.0.1:4200
AI_ASSISTANT_PROVIDER=apps.assistant.services.OllamaAssistantProvider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_HISTORY=10
OLLAMA_NUM_PREDICT=300
CHATBOT_THROTTLE_RATE=30/minute
